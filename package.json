{
  "name": "penpotx",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "fmt": "oxfmt \"**/*.{ts,json,html}\"",
    "fmt:check": "oxfmt --check \"**/*.{ts,json,html}\"",
    "lint": "oxlint --deny-warnings",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "packageManager": "pnpm@12.14.0"
}
